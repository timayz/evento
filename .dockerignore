# Keep the Docker build context small. The evento-cluster Jepsen node image builds
# the workspace from source; shipping target/ or VCS data would bloat the context.
target/
.git/
evento-cluster/jepsen/store/
**/*.log
# NOTE: do not ignore evento-cluster/jepsen/docker/secret/ — the Dockerfiles COPY
# the generated keypair from there into the images.
